# Meta Graph API Credenciais
META_ACCESS_TOKEN=your_meta_user_or_system_user_token_here
META_API_VERSION=v19.0

# Configurações de Auditoria
DEFAULT_PAGE_ID=100064567890123
DEFAULT_TARGET_NAME="Augusto Cury"
DEFAULT_KEYWORD="Augusto Cury"

# Limiares de Detecção Estatística
AD_BURST_THRESHOLD=50           # Anúncios criados no mesmo minuto/janela para considerar spam automatizado
TRENDS_NIGHT_THRESHOLD=60.0     # Média mínima de interesse entre 01:00 e 05:00 para sinalizar platô suspeito
TRENDS_VARIANCE_MAX=150.0       # Variância máxima tolerada para caracterizar platô inorgânico contínuo
